<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VMentory.Web</RootNamespace>
    <AssemblyName>VMentory</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!-- app.manifest (requireAdministrator) is a Windows PE feature — only apply it on Windows builds
         so the Linux container publish (ENG-0010) doesn't fail. -->
    <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="VMentory.Core\VMentory.Core.csproj" />
  </ItemGroup>

  <!-- This project lives at the repo root, so the SDK's default globs would otherwise pull in
       sibling project folders (VMentory.Core, and later Providers.*/Agent). Exclude them here.
       Add a line per new sibling project as it lands. -->
  <ItemGroup>
    <Compile Remove="VMentory.Core\**" />
    <Content Remove="VMentory.Core\**" />
    <EmbeddedResource Remove="VMentory.Core\**" />
    <None Remove="VMentory.Core\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed static assets so they survive single-file publish -->
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>
</Project>
